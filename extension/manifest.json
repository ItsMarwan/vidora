{
  "manifest_version": 3,
  "name": "Vidora Stream Extractor",
  "version": "1.0",
  "description": "Extract and play direct media streams with Vidora custom player.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.akwam.it/*",
    "https://akwam.it/*"
  ],
  "icons": {
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  }
}